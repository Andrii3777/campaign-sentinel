{
  "name": "@campaign-sentinel/api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsc -p tsconfig.build.json && node prisma/seed.mjs",
    "db:reset": "prisma migrate reset --force && pnpm run db:seed",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.mts",
    "dev": "tsc -p tsconfig.build.json && pnpm run \"/^watch:/\"",
    "watch:tsc": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "watch:node": "node --watch dist/main.js",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@campaign-sentinel/contracts": "workspace:*",
    "@google/genai": "^2.30.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "node-html-parser": "^9.0.4",
    "openai": "^7.36.0",
    "playwright-core": "^1.64.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "~1.32.1",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "prisma": "7.10.1",
    "supertest": "^7.3.1"
  }
}
