# Copy with `pnpm run setup` (generates SENTINEL_AGENT_TOKEN). Never commit .env.
DATABASE_URL=postgresql://postgres@localhost:5433/campaign_sentinel
DATABASE_URL_TEST=postgresql://postgres@localhost:5433/campaign_sentinel_test
API_PORT=4000
# listen address of the API (the public API has no login); the compose api service sets 0.0.0.0
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000
SENTINEL_AGENT_TOKEN=
# empty = API_INTERNAL_URL, else http://127.0.0.1:API_PORT; read by apps/mcp (process environment first, then this file)
SENTINEL_API_URL=
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
OPENAI_API_KEY=
# empty = default (gpt-6-astra)
OPENAI_MODEL=
GEMINI_API_KEY=
# empty = default (gemini-3.5-flash)
GEMINI_MODEL=
# OpenClaw is optional: see docs/openclaw.md
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_AGENT_ID=sentinel
BROWSER_CHECKS=auto
# test only; refused when NODE_ENV=production
URL_FETCH_ALLOW_PRIVATE=
